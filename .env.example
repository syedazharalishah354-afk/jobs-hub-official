# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://jobshubofficial.com)
APP_URL="https://jobshubofficial.com"

# PORT: Server port provided by Hostinger hosting environment (e.g., 3000)
PORT=3000

# NODE_ENV: Set to production for Hostinger deployment
NODE_ENV=production

# JWT_SECRET: Secret key used to sign session and admin JWT tokens
JWT_SECRET="your_production_jwt_secret_key_here"
